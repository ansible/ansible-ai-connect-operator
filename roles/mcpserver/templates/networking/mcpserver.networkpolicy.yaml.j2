# Allow policy for MCP Server pods.
# Ingress: any source on the HTTP serving port (exposed via ingress/route/NodePort)
#          plus internal operator and gateway traffic.
# Egress: unrestricted — MCP Server connects to external tool endpoints whose
# destinations are user-configured and cannot be enumerated at policy time.
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: '{{ ansible_operator_meta.name }}-mcpserver'
  namespace: '{{ ansible_operator_meta.namespace }}'
  labels:
    {{ lookup("template", "../common/templates/labels/common.yaml.j2") | indent(4) | trim }}
    app.kubernetes.io/component: '{{ deployment_type }}'
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: '{{ ansible_operator_meta.name }}'
      app.kubernetes.io/managed-by: '{{ deployment_type }}-operator'
      app.kubernetes.io/component: '{{ deployment_type }}'
  policyTypes:
    - Ingress
    - Egress
  ingress:
    - ports:
        - protocol: TCP
          port: {{ default_http_port }}
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: openshift-dns
      ports:
        - protocol: TCP
          port: 5353
        - protocol: UDP
          port: 5353
    - {}
